# ============================================================
# Intelligent Acquisition Navigator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# All VITE_* variables are exposed to the browser bundle.
# ============================================================

# --- Supabase (Database + Auth) ---
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Azure OpenAI ---
# Found in: Azure Portal → Cognitive Services → Keys and Endpoint
VITE_AZURE_ENDPOINT=https://<resource-name>.openai.azure.com/
VITE_AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
# Deployment name configured in Azure OpenAI Studio (default: gpt-4o)
VITE_AZURE_DEPLOYMENT_ID=gpt-4o

# --- Pinecone (Vector Store / RAG) ---
# Found in: Pinecone Console → API Keys
VITE_PINECONE_API_KEY=<your-pinecone-api-key>
# Index name created in Pinecone Console
VITE_PINECONE_INDEX_NAME=acquisition-knowledge-base
