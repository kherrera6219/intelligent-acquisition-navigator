# ============================================================
# Intelligent Acquisition Navigator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# All VITE_* variables are exposed to the browser bundle.
# ============================================================

# --- AI Provider Selection (only external API dependency) ---
# Choose which LLM provider powers chat, reasoning, and research: "openai" or "gemini"
VITE_AI_PROVIDER=openai

# --- OpenAI (used when VITE_AI_PROVIDER=openai) ---
VITE_OPENAI_API_KEY=<your-openai-api-key>
VITE_OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (used when VITE_AI_PROVIDER=gemini) ---
VITE_GEMINI_API_KEY=<your-gemini-api-key>
VITE_GEMINI_MODEL=gemini-1.5-flash

# --- Optional Contact Display ---
VITE_CONTACT_EMAIL=contact@acquisitionnavigator.gov
VITE_CONTACT_PHONE=+1 (800) 555-0100
