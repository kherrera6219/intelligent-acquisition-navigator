# ============================================================
# Intelligent Acquisition Navigator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# All VITE_* variables are exposed to the browser bundle.
# ============================================================

# --- Azure OpenAI (only external API dependency) ---
VITE_AZURE_ENDPOINT=https://<resource-name>.openai.azure.com
VITE_AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
VITE_AZURE_DEPLOYMENT_ID=gpt-4o
VITE_AZURE_OPENAI_API_VERSION=2024-06-01

# --- Optional Contact Display ---
VITE_CONTACT_EMAIL=contact@acquisitionnavigator.gov
VITE_CONTACT_PHONE=+1 (800) 555-0100
