# ─────────────────────────────────────────────────────────────────────────────
# ProcurityIQ — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Required for the AI Assistant, Compliance Scanner, and AI Proposal Writer.
# Get your key at: https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ── SAM.gov Opportunities API ─────────────────────────────────────────────────
# Optional. When not set the Opportunities page shows 5 demo records.
# Request a free API key at: https://sam.gov/content/entity-information
VITE_SAM_GOV_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# These values are the PUBLIC anon key — safe to expose in client-side code.
# They are pre-filled to the project defaults; override only if you fork
# the Supabase project.
#
# Project: https://supabase.com/dashboard/project/bosxxgbinzcjgwjaotyb
VITE_SUPABASE_URL=https://bosxxgbinzcjgwjaotyb.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJvc3h4Z2Jpbnpjamd3amFvdHliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDEyMTQxMTIsImV4cCI6MjA1Njc5MDExMn0.QitxMh7_PBBzMECCxNJzPi5lK5cOgOVVLSHUuCqSiIM

# ── Pinecone Vector Store (optional) ─────────────────────────────────────────
# Required only if you enable the RAG knowledge-base feature.
# Get your key at: https://app.pinecone.io/
VITE_PINECONE_API_KEY=
VITE_PINECONE_ENVIRONMENT=
VITE_PINECONE_INDEX=
